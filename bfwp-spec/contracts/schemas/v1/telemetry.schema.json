{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bfwp.local/schemas/v1/telemetry.schema.json",
  "title": "BFWP telemetry (single reading) v1",
  "type": "object",
  "required": ["v", "dev", "seq", "ts", "psi", "amps", "pump", "gal_total", "gpm"],
  "properties": {
    "v":         { "const": 1 },
    "dev":       { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
    "seq":       { "type": "integer", "minimum": 0 },
    "ts":        { "type": "integer", "minimum": 1735689600000, "description": "UTC epoch ms, >= 2025-01-01" },
    "psi":       { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "amps":      { "type": ["number", "null"], "minimum": 0, "maximum": 512 },
    "pump":      { "enum": [0, 1] },
    "gal_total": { "type": "integer", "minimum": 0 },
    "gpm":       { "type": "number", "minimum": 0, "maximum": 200 },
    "amps_raw":  { "type": "integer", "minimum": 0, "description": "Optional, calibration only" }
  },
  "additionalProperties": true
}
