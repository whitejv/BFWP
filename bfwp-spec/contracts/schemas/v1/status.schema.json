{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bfwp.local/schemas/v1/status.schema.json",
  "title": "BFWP device status v1 (retained; also Last Will with online=false)",
  "type": "object",
  "required": ["dev", "online"],
  "properties": {
    "dev":    { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
    "online": { "type": "boolean" },
    "ts":     { "type": "integer", "minimum": 1735689600000 },
    "fw":     { "type": "string" },
    "rssi":   { "type": "integer", "minimum": -127, "maximum": 0 }
  },
  "if":   { "properties": { "online": { "const": true } } },
  "then": { "required": ["ts", "fw"] },
  "additionalProperties": true
}
