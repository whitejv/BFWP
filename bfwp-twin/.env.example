# Public HiveMQ broker. It does not check the username or password.
# A private broker later is a new host plus a password here. Use the sim
# credential then, never the real device's.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_USERNAME=bfwp-twin
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=bfwp-sim
DEVICE_ID=twin1
TRUTH_LOG_DIR=./truth-logs
